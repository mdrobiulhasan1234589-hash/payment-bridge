<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_backend_url"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etBackendUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_backend_url"
        android:inputType="textUri"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:backgroundTint="@color/accent_blue"
        android:layout_marginBottom="16dp"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_bridge_secret"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etBridgeSecret"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_bridge_secret"
        android:inputType="textPassword"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:backgroundTint="@color/accent_blue"
        android:importantForAutofill="no" />

</LinearLayout>
